# CriptoLab - Secrets Example
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# Binance API (Mainnet - for real trading)
# IMPORTANT: NEVER enable withdrawals on these API keys
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Binance Testnet (for testing only)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# App Configuration
KILL_SWITCH=true
APP_MODE=paper
