# CriptoLab environment overrides (Docker Compose)
# Copy to .env and adjust as needed.

# App mode: analysis | backtest | paper | real_manual | real_auto_limited
APP_MODE=analysis

# Kill switch: true blocks all trading
KILL_SWITCH=true

# Database path inside the container
DATABASE_PATH=/data/market.db

# Port mappings (host:container)
API_PORT=8001
DASHBOARD_PORT=8501
WEB_PORT=3001

# API base URL for frontend
API_BASE=http://api:8000/api/v1
